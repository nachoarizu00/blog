---
import Base from '../layouts/Base.astro';
import Nota from '../components/Nota.astro';
import Marca from '../components/Marca.astro';
import Pieza from '../components/Pieza.astro';
import Pincelada from '../components/Pincelada.astro';
import { todosLosArticulos, rutaArticulo } from '../lib/articulos';

// La portada se arma con los 7 textos más recientes, pero funciona con cualquier cantidad.
const [principal, cita, a, b, c, d, e] = (await todosLosArticulos()).slice(0, 7);
---
<Base portada>
  <section class="mastil">
    <h1 class="mastil__banda">
      <img class="mastil__imagen" src="/arte/encabezado.webp" width="2000" height="667" alt="cualquiera" fetchpriority="high" decoding="async" />
    </h1>
    <div class="mastil__pie">
      <p class="mastil__lema">
        <Nota flecha="bajando">pensamos en serio,<br />escribimos como queremos</Nota>
      </p>
      <p class="mastil__sub etiqueta">Revista cultural colectiva — ensayos, crítica e intervenciones libres</p>
    </div>
  </section>

  <div class="pared">
    <Pincelada tipo="garabatos-a" class="suelta suelta--1" />
    <Pincelada tipo="garabatos-b" class="suelta suelta--2" />
    <Pincelada tipo="garabatos-c" class="suelta suelta--3" />

    {principal && <Pieza articulo={principal} variante="principal" marca="subrayado" />}

    {cita && (
      <blockquote class="cita">
        <p>
          «<Marca tipo="resaltado">{cita.data.pull ?? cita.data.dek}</Marca>»
        </p>
        <footer>
          — <a href={rutaArticulo(cita)}>{cita.data.title}</a>, <span class="etiqueta">{cita.data.autor}</span>
        </footer>
      </blockquote>
    )}

    {a && <Pieza articulo={a} variante="a" marca="circulo" />}
    {b && <Pieza articulo={b} variante="b" marca="resaltado" />}

    <aside class="temas">
      <p class="etiqueta">De qué hablamos</p>
      <ul>
        <li>política</li>
        <li>derecho</li>
        <li>arte</li>
        <li>cine</li>
        <li>literatura</li>
        <li>música</li>
        <li>filosofía</li>
        <li><Marca tipo="tachado">etcétera</Marca></li>
      </ul>
      <Nota flecha="arriba" class="temas__nota">cualquier cosa</Nota>
    </aside>

    {c && <Pieza articulo={c} variante="c" marca="subrayado" />}
    {d && <Pieza articulo={d} variante="d" marca="circulo" />}
    {e && <Pieza articulo={e} variante="e" marca="resaltado" />}

    <a class="todo" href="/archivo/">
      <span>Todo lo publicado</span>
      <Marca tipo="subrayado">archivo</Marca>
      <span class="todo__flecha" aria-hidden="true">→</span>
    </a>
  </div>
</Base>
