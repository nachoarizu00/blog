---
import Base from '../layouts/Base.astro';
import Pincelada from '../components/Pincelada.astro';
import Nota from '../components/Nota.astro';
---
<Base titulo="Contacto">
  <section class="archivo">
    <header class="archivo__encabezado">
      <Pincelada tipo="celeste" class="archivo__pincelada" />
      <h1 class="archivo__titulo">contacto</h1>
      <p class="etiqueta">Próximamente</p>
      <Nota class="archivo__nota">estamos escribiendo esto</Nota>
    </header>
  </section>
</Base>
