---
import Base from '../layouts/Base.astro';
import Pincelada from '../components/Pincelada.astro';
import Nota from '../components/Nota.astro';
import { todosLosArticulos, fechaCorta, rutaArticulo, minutosDeLectura } from '../lib/articulos';

const articulos = await todosLosArticulos();
const porAnio = new Map<number, typeof articulos>();
for (const art of articulos) {
  const anio = art.data.fecha.getUTCFullYear();
  porAnio.set(anio, [...(porAnio.get(anio) ?? []), art]);
}
---
<Base titulo="Archivo" descripcion="Todo lo publicado en cualquiera, del más reciente al más antiguo.">
  <section class="archivo">
    <header class="archivo__encabezado">
      <Pincelada tipo="celeste" class="archivo__pincelada" />
      <h1 class="archivo__titulo">archivo</h1>
      <p class="etiqueta">{articulos.length} textos, de más nuevo a más viejo</p>
      <Nota flecha="abajo" class="archivo__nota">todo lo que hay, hasta ahora</Nota>
    </header>

    {[...porAnio].map(([anio, lista]) => (
      <section class="anio">
        <h2 class="anio__numero" aria-label={String(anio)}>{anio}</h2>
        <ol class="anio__lista">
          {lista.map((art) => (
            <li class="fila">
              <a href={rutaArticulo(art)}>
                <span class="fila__fecha etiqueta">{fechaCorta(art.data.fecha)}</span>
                <span class="fila__titulo">{art.data.title}</span>
                <span class="fila__meta etiqueta">
                  {art.data.seccion}<br />{art.data.autor} · {minutosDeLectura(art)} min
                </span>
              </a>
            </li>
          ))}
        </ol>
      </section>
    ))}
  </section>
</Base>
