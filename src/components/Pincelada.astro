---
// Pintura abstracta (public/arte, generada con tools/pintar.py). Decoración pura.
interface Props {
  tipo: 'encabezado' | 'diagonal' | 'celeste' | 'garabatos-a' | 'garabatos-b' | 'garabatos-c';
  class?: string;
}
const { tipo, class: clase } = Astro.props;
const medidas = { encabezado: [2800, 900], diagonal: [2400, 1100], celeste: [1800, 450], 'garabatos-a': [1000, 700], 'garabatos-b': [1000, 600], 'garabatos-c': [1100, 500] } as const;
const [w, h] = medidas[tipo];
---
<img class:list={['pincelada', clase]} src={`/arte/${tipo}.webp`} width={w} height={h} alt="" aria-hidden="true" decoding="async" loading={tipo === 'diagonal' || tipo === 'celeste' ? 'eager' : 'lazy'} />
