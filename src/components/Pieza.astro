---
import Titulo from './Titulo.astro';
import { fechaCorta, rutaArticulo, type Articulo } from '../lib/articulos';

interface Props {
  articulo: Articulo;
  variante: 'principal' | 'a' | 'b' | 'c' | 'd' | 'e';
  marca: 'subrayado' | 'circulo' | 'resaltado';
}
const { articulo, variante, marca } = Astro.props;
const { seccion, fecha, title, enfasis, dek, autor } = articulo.data;
---
<article class={`pieza pieza--${variante}`}>
  <p class="etiqueta">{seccion} · {fechaCorta(fecha)}</p>
  <h2 class="pieza__titulo">
    <a href={rutaArticulo(articulo)}><Titulo titulo={title} enfasis={enfasis} marca={marca} /></a>
  </h2>
  <p class="pieza__dek">{dek}</p>
  <p class="etiqueta">por {autor}</p>
</article>
