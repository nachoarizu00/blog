---
const secciones = [
  { texto: 'Principal', href: '/' },
  { texto: 'Archivo', href: '/archivo/' },
  { texto: 'Nosotros', href: '/nosotros/' },
  { texto: 'Contacto', href: '/contacto/' },
];
const actual = Astro.url.pathname;
---
<button class="menu-boton" type="button" aria-label="Abrir menú" aria-haspopup="dialog" aria-controls="menu" data-menu-abrir>
  <span></span><span></span><span></span>
</button>

<dialog id="menu" class="menu" aria-label="Menú">
  <div class="menu__panel">
    <button class="menu__cerrar" type="button" aria-label="Cerrar menú" data-menu-cerrar>
      <span></span><span></span>
    </button>
    <nav aria-label="Principal">
      <ul class="menu__lista">
        {secciones.map((s, i) => (
          <li>
            <a href={s.href} aria-current={(s.href === '/' ? actual === '/' : actual.startsWith(s.href)) ? 'page' : undefined}>
              <span class="etiqueta menu__numero">{String(i + 1).padStart(2, '0')}</span>
              <span class="menu__texto">{s.texto}</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</dialog>

<script>
  // Delegación en document: sigue funcionando después de cada navegación (ClientRouter reemplaza el DOM).
  const DURACION = 420;
  let cerrando = false;
  const menu = () => document.querySelector<HTMLDialogElement>('#menu');
  const boton = () => document.querySelector<HTMLButtonElement>('[data-menu-abrir]');

  function abrirMenu() {
    const m = menu();
    if (!m || m.open) return;
    m.showModal();
    boton()?.setAttribute('aria-expanded', 'true');
    requestAnimationFrame(() => m.classList.add('menu--visible'));
  }

  function cerrarMenu() {
    const m = menu();
    if (!m || !m.open || cerrando) return;
    cerrando = true;
    m.classList.remove('menu--visible');
    const terminar = () => {
      m.close();
      boton()?.setAttribute('aria-expanded', 'false');
      cerrando = false;
    };
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) terminar();
    else setTimeout(terminar, DURACION);
  }

  document.addEventListener('click', (e) => {
    const t = e.target as HTMLElement;
    if (t.closest('[data-menu-abrir]')) abrirMenu();
    else if (t.closest('[data-menu-cerrar]')) cerrarMenu();
    else if (t.id === 'menu') cerrarMenu();            // clic sobre el fondo atenuado
  });
  // Esc: usamos nuestra animación en lugar del cierre abrupto
  document.addEventListener('cancel', (e) => {
    if ((e.target as HTMLElement).id === 'menu') { e.preventDefault(); cerrarMenu(); }
  }, true);
  // al navegar, el menú nuevo arranca cerrado
  document.addEventListener('astro:after-swap', () => { cerrando = false; });
</script>
