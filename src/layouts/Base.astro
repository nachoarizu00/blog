---
import '@fontsource-variable/fraunces/full.css';
import '@fontsource-variable/fraunces/full-italic.css';
import '@fontsource-variable/newsreader/opsz.css';
import '@fontsource-variable/newsreader/opsz-italic.css';
import '@fontsource/reenie-beanie/400.css';
import '@fontsource/ibm-plex-mono/400.css';
import '../styles/global.css';
import Cabecera from '../components/Cabecera.astro';
import Pie from '../components/Pie.astro';
import { ClientRouter } from 'astro:transitions';

interface Props {
  titulo?: string;
  descripcion?: string;
  portada?: boolean;
  logoImagen?: boolean;
}
const {
  titulo,
  descripcion = '¿Vos en cuál estás?',
  portada = false,
  logoImagen = false,
} = Astro.props;
const tituloPagina = titulo ? `${titulo} — cualquiera Online` : 'cualquiera Online';
const urlCanonica = new URL(Astro.url.pathname, Astro.site ?? Astro.url).href;
const imagenCompartir = new URL('/og.png', Astro.site ?? Astro.url).href;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={descripcion} />
    <meta name="theme-color" content="#ffffff" />
    <link rel="canonical" href={urlCanonica} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="cualquiera Online" />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:title" content={tituloPagina} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content={urlCanonica} />
    <meta property="og:image" content={imagenCompartir} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/icono.ico?v=3" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/icono-32.png?v=3" />
    <link rel="icon" type="image/png" sizes="192x192" href="/icono-192.png?v=3" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=3" />
    <title>{tituloPagina}</title>
    <ClientRouter />
  </head>
  <body>
    <Cabecera portada={portada} logoImagen={logoImagen} />
    <main>
      <slot />
    </main>
    <Pie />
  </body>
</html>
