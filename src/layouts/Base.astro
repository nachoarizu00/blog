---
import '@fontsource-variable/fraunces/full.css';
import '@fontsource-variable/fraunces/full-italic.css';
import '@fontsource-variable/newsreader/opsz.css';
import '@fontsource-variable/newsreader/opsz-italic.css';
import '@fontsource/reenie-beanie/400.css';
import '@fontsource/ibm-plex-mono/400.css';
import '../styles/global.css';
import Cabecera from '../components/Cabecera.astro';
import Pie from '../components/Pie.astro';
import { ClientRouter } from 'astro:transitions';

interface Props {
  titulo?: string;
  descripcion?: string;
  portada?: boolean;
  logoImagen?: boolean;
}
const {
  titulo,
  descripcion = 'cualquiera, revista cultural colectiva de ensayos, crítica e intervenciones libres. Pensamos en serio, escribimos como queremos.',
  portada = false,
  logoImagen = false,
} = Astro.props;
const tituloPagina = titulo ? `${titulo} — cualquiera` : 'cualquiera — revista cultural colectiva';
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={descripcion} />
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{tituloPagina}</title>
    <ClientRouter />
  </head>
  <body>
    <Cabecera portada={portada} logoImagen={logoImagen} />
    <main>
      <slot />
    </main>
    <Pie />
  </body>
</html>
